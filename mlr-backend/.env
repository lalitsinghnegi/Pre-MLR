# Copy to mlr-backend/.env (backend) and mlr-frontend/.env (frontend, VITE_* only).
# Never commit real .env files.

# --- Backend ---
PORT=8000
# SQLite file path for dev (relative to mlr-backend/). Postgres support comes later.
DATABASE_URL=./data/pre-mlr.db
# Where screenshots, site maps and PDFs are written (relative to mlr-backend/).
DATA_DIR=./data
# Allowed browser origin for CORS (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

