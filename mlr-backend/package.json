{
  "name": "@pre-mlr/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "user": "tsx --env-file-if-exists=.env scripts/users.ts",
    "serve:examplin": "tsx scripts/serve-site.ts ../test-sites/examplin 4100",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts",
    "precedent:import": "tsx --env-file-if-exists=.env scripts/precedent-import.ts",
    "precedent:classify": "tsx --env-file-if-exists=.env scripts/precedent-classify.ts",
    "precedent:embed": "tsx --env-file-if-exists=.env scripts/precedent-embed.ts",
    "precedent:generate": "tsx scripts/generate-precedents.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@hpcc-js/wasm-graphviz": "^1.29.2",
    "@huggingface/transformers": "^4.3.0",
    "@pre-mlr/shared": "*",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "playwright": "^1.63.0",
    "robots-parser": "^3.0.1",
    "sharp": "^0.35.5",
    "undici": "^7.30.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "unpdf": "^1.8.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
